+
+fn emitOrderedIds(e: Author, ids: Id) Error!Id {
+    const b = e.b;
+    const check = try b.declare(&.{ ids, e.integer, e.integer }, e.boolean, &.{}, &.{});
+    const values = try e.param(check, 0);
+    const index = try e.param(check, 1);
+    const previous = try e.param(check, 2);
+    const length = try b.primitive(e.integer, .sequence_length, &.{values}, 0);
+    const current = try e.required(values, index);
+    try b.define(check, try e.when(
+        try e.binary(.less, index, length),
+        try e.when(
+            try e.binary(.less, current, previous),
+            try b.pure(try b.constant(bool, false)),
+            try e.call(check, &.{ values, try e.binary(.integer_add, index, e.one), current }),
+        ),
+        try b.pure(try b.constant(bool, true)),
+    ));
+    return check;
+}
+
+fn emitSequenceLeaf(e: Author, slots: maps.Definition, ids: Id, result: Id) Error!Id {
+    const b = e.b;
+    const leaf = try b.declare(
+        &.{ slots.tree, ids, e.integer, e.integer },
+        result,
+        &.{},
+        &.{},
+    );
+    const input = try e.param(leaf, 0);
+    const values = try e.param(leaf, 1);
+    const index = try e.param(leaf, 2);
+    const key = try e.param(leaf, 3);
+    const length = try b.primitive(e.integer, .sequence_length, &.{values}, 0);
+    const current = try e.required(values, index);
+    const next = try e.binary(.integer_add, index, e.one);
+    const absent = try b.pure(try e.tuple(result, &.{ try slots.empty(e), index }));
+    const found = try e.when(
+        try e.binary(.equal, key, current),
+        try b.pure(try e.tuple(result, &.{ input, next })),
+        absent,
+    );
+    try b.define(leaf, try e.when(
+        try e.binary(.less, index, length),
+        try e.when(
+            try e.binary(.less, current, key),
+            try e.call(leaf, &.{ input, values, next, key }),
+            found,
+        ),
+        absent,
+    ));
+    return leaf;
+}
+
+fn emitSequenceRetain(e: Author, slots: maps.Definition, ids: Id) Error!Id {
+    const b = e.b;
+    const result = try b.schema(.{ .product = &.{ slots.tree, e.integer } });
+    const leaf = try emitSequenceLeaf(e, slots, ids, result);
+    const walk = try b.declare(&.{ slots.tree, ids, e.integer }, result, &.{}, &.{});
+    try emitSequenceWalk(e, slots, result, walk, leaf);
+    const retain = try b.declare(&.{ slots.tree, ids }, slots.tree, &.{}, &.{});
+    const pruned = try b.variable(result);
+    try b.define(retain, try b.bind(pruned, try e.call(walk, &.{
+        try e.param(retain, 0), try e.param(retain, 1), e.zero,
+    }), try b.pure(try e.field(try b.reference(pruned), 0))));
+    return retain;
+}
+
+fn emitSequenceWalk(e: Author, slots: maps.Definition, result: Id, walk: Id, leaf_at: Id) Error!void {
+    const b = e.b;
+    const input = try e.param(walk, 0);
+    const allowed = try e.param(walk, 1);
+    const index = try e.param(walk, 2);
+    const nil = try b.variable(e.unit);
+    const leaf = try b.variable(slots.entry);
+    const fork = try b.variable(slots.branch);
+    const node = try b.reference(fork);
+    const left_var = try b.variable(result);
+    const right_var = try b.variable(result);
+    const left_result = try b.reference(left_var);
+    const right_result = try b.reference(right_var);
+    const l = try e.field(left_result, 0);
+    const r = try e.field(right_result, 0);
+    const finish = try e.field(right_result, 1);
+    const retained = try b.bind(left_var, try e.call(walk, &.{
+        try e.field(node, 1), allowed, index,
+    }), try b.bind(right_var, try e.call(walk, &.{
+        try e.field(node, 2), allowed, try e.field(left_result, 1),
+    }), try e.when(
+        try isEmpty(e, l),
+        try b.pure(right_result),
+        try e.when(
+            try isEmpty(e, r),
+            try b.pure(try e.tuple(result, &.{ l, finish })),
+            try b.pure(try e.tuple(result, &.{
+                try e.variant(slots.tree, 2, try e.tuple(
+                    slots.branch,
+                    &.{ try e.field(node, 0), l, r },
+                )),
+                finish,
+            })),
+        ),
+    )));
+    const length = try b.primitive(e.integer, .sequence_length, &.{allowed}, 0);
+    const traverse = try b.term(.{ .match_sum = .{ .value = input, .cases = &.{
+        .{ .variable = nil, .body = try b.pure(try e.tuple(result, &.{ input, index })) },
+        .{ .variable = leaf, .body = try e.call(leaf_at, &.{
+            input, allowed, index, try e.field(try b.reference(leaf), 0),
+        }) },
+        .{ .variable = fork, .body = retained },
+    } } });
+    try b.define(walk, try e.when(
+        try e.binary(.less, index, length),
+        traverse,
+        try b.pure(try e.tuple(result, &.{ try slots.empty(e), index })),
+    ));
